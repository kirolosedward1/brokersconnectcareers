{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)mobile' ':(exclude).github/workflows/mobile.yml'",
  "crons": [
    {
      "path": "/api/cron/expire-jobs",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/job-alerts",
      "schedule": "0 6-11 * * 1"
    },
    {
      "path": "/api/cron/email-retry",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/lifecycle",
      "schedule": "23 2 * * *"
    },
    {
      "path": "/api/cron/push",
      "schedule": "*/5 * * * *"
    }
  ]
}
