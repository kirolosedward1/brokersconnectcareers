{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "git": {
    "deploymentEnabled": {
      "look-shots": false
    }
  },
  "ignoreCommand": "b=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}; git cat-file -e \"$b^{commit}\" 2>/dev/null || exit 1; [ \"$(git rev-parse \"$b\")\" = \"$(git rev-parse HEAD)\" ] && exit 1; git diff --quiet \"$b\" HEAD -- . ':!mobile' ':!.github/workflows/mobile.yml'",
  "crons": [
    {
      "path": "/api/cron/expire-jobs",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/job-alerts",
      "schedule": "0 6-11 * * 1"
    },
    {
      "path": "/api/cron/new-jobs",
      "schedule": "17 7 * * *"
    },
    {
      "path": "/api/cron/email-retry",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/lifecycle",
      "schedule": "23 2 * * *"
    },
    {
      "path": "/api/cron/push",
      "schedule": "*/5 * * * *"
    }
  ]
}
