# --- Supabase ---------------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used by cron + admin actions.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> Database -> Connection string -> URI. Direct connection,
# not the transaction pooler. Used only by scripts/db-push.mjs and
# scripts/seed-demo.mjs; the app never reads it.
DATABASE_URL=

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Feature flags ----------------------------------------------------------
# Phase 5. Keep false until the board has candidate volume.
BILLING_ENABLED=false

# --- Cron -------------------------------------------------------------------
# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# --- Security ---------------------------------------------------------------
# Salt for the hashes the security log keeps in place of IP and email
# addresses (src/lib/security/request.ts). Any long random string; a different
# one per environment, so staging and production hashes never compare. Falls
# back to CRON_SECRET, and to a fixed development value if neither is set.
SECURITY_SALT=

# Cloudflare Turnstile. The site key renders the (usually invisible) widget on
# sign-in, sign-up and the reset form; the secret is what verifies a token.
# Supabase Auth does that verification when the same secret is entered under
# Authentication -> Attack Protection -> CAPTCHA (provider: Turnstile) — that
# is the setting that makes a token *required*, including for a script calling
# the auth server directly. Leave both unset and no widget renders.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Whether an admin without a second factor may open the console.
# Unset: required in production, not in development. `false` is the escape
# hatch for a locked-out team; the database still refuses an admin who *has*
# enrolled a factor until the session has used it (migration 76).
# ADMIN_MFA_REQUIRED=true

# --- Analytics --------------------------------------------------------------
# Cookie-free, so no consent banner. Leave unset and no script is loaded at all.
# provider: plausible | umami
NEXT_PUBLIC_ANALYTICS_PROVIDER=
# Plausible: the domain you registered. Umami: the website id.
NEXT_PUBLIC_ANALYTICS_SITE=
# Only for a self-hosted instance.
NEXT_PUBLIC_ANALYTICS_SRC=

# --- Email ------------------------------------------------------------------
# Resend. The whole `Name <address>` form, so the display name is configuration
# rather than a string spelled into a template. The domain must be verified in
# Resend before anything sends — an unverified one answers 403 on every call.
RESEND_API_KEY=
RESEND_FROM="Brokers Connect <noreply@brokersconnect.net>"

# Signs Resend's delivery webhook (Resend dashboard -> Webhooks -> Signing
# secret, `whsec_...`). Without it /api/email/webhook refuses every callback
# rather than trusting an unsigned one — accepting would let anyone mark any
# message delivered, or suppress any address on the platform, which is a
# denial-of-service against password resets.
RESEND_WEBHOOK_SECRET=

# Optional. Where an email tells somebody to go when it did not answer their
# question. Unset by default because this platform has no support page, and a
# help link to a 404 is worse than no help line — leave it blank and the block
# is omitted entirely.
SUPPORT_EMAIL=

# --- Paymob (phase 5) -------------------------------------------------------
# Checkout stays unreachable until all four are set AND BILLING_ENABLED=true.
# The webhook refuses outright without the HMAC secret rather than trusting an
# unsigned callback — it grants paid credits.
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# Shows the shared demo-account buttons on /sign-in. Their password is public,
# so this must never be set on a deployment whose listings can receive real
# applicants. Leave unset in production.
# NEXT_PUBLIC_DEMO_LOGIN=true
