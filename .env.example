# --- Supabase ---------------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used by cron + admin actions.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> Database -> Connection string -> URI. Direct connection,
# not the transaction pooler. Used only by scripts/db-push.mjs and
# scripts/seed-demo.mjs; the app never reads it.
DATABASE_URL=

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Feature flags ----------------------------------------------------------
# Phase 5. Keep false until the board has candidate volume.
BILLING_ENABLED=false

# --- Cron -------------------------------------------------------------------
# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# --- Email (phase 3+) -------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM="Brokers Connect <no-reply@example.com>"

# --- Paymob (phase 5) -------------------------------------------------------
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
