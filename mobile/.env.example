# Copy to .env for `expo start`. EAS builds take these from eas.json instead.
#
# The production Supabase project and its publishable key — the same public,
# client-side key the website ships in its JavaScript. Row-level security is
# what protects the data, not this key. Point these at a staging project to
# develop against something other than production.
EXPO_PUBLIC_SUPABASE_URL=https://hiwdhicwsohbipxzazmb.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ghKaq9WMTXgn01IEJuh-EA_LEa9Nlry

# The website: /api/mobile/v1 lives here, and universal links point here.
EXPO_PUBLIC_SITE_URL=https://www.brokersconnect.net

# Google Sign-In. Public OAuth client ids, not secrets — they ship in the
# app. Empty until they exist in Google Cloud. The same three belong in
# eas.json under build.base.env before a development or store build, and
# before an over-the-air update of one: a build without them has no Google
# sheet. What to create in Google Cloud and what to turn on in Supabase is
# in docs/mobile.md, "Configuration".
#
# Web: the client the website already uses. Android's identity token is
# issued for this id, so the native sheet needs it.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS: an iOS client whose bundle id is net.brokersconnect.app. The build
# registers its reversed form as a URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android: an Android client for package net.brokersconnect.app, with the
# signing certificates. The native sheet's token is issued for the web id;
# this id is what the Expo Go fallback sends, and Supabase must list it too.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
