{
  "name": "real-estate-jobs-eg",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:lint": "node scripts/release/migrations.mjs lint",
    "db:new": "node scripts/release/migrations.mjs new",
    "db:ledger": "node scripts/release/migrations.mjs ledger",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:push:url": "node scripts/db-push.mjs",
    "db:reset:url": "node scripts/db-push.mjs --reset",
    "db:seed:demo": "node scripts/seed-demo.mjs",
    "doctor": "node scripts/doctor.mjs",
    "db:rehearse": "node scripts/db-rehearse.mjs",
    "lifecycle:audit": "node scripts/lifecycle-audit.mjs",
    "dr:backup": "bash scripts/dr/db-backup.sh",
    "dr:restore": "bash scripts/dr/db-restore.sh",
    "dr:verify": "node scripts/dr/verify.mjs",
    "dr:drift": "node scripts/dr/drift.mjs",
    "dr:rehearse": "node scripts/dr/rehearse.mjs",
    "dr:storage:backup": "node scripts/dr/storage-backup.mjs",
    "dr:storage:restore": "node scripts/dr/storage-restore.mjs",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "test:db": "node supabase/tests/schema.test.mjs && node supabase/tests/policies.test.mjs && node supabase/tests/security.test.mjs && node supabase/tests/notifications.test.mjs && node supabase/tests/lifecycle.test.mjs && node supabase/tests/lifecycle-concurrency.test.mjs && node --experimental-strip-types supabase/tests/hmac.test.mjs && pnpm test:search && pnpm test:email && pnpm test:auth && pnpm test:support && pnpm test:jobs",
    "test:hmac": "node --experimental-strip-types supabase/tests/hmac.test.mjs",
    "test:lifecycle": "node supabase/tests/lifecycle.test.mjs && node supabase/tests/lifecycle-concurrency.test.mjs",
    "test:notifications": "node supabase/tests/notifications.test.mjs && node --experimental-strip-types scripts/notification-links.test.mjs && node --experimental-strip-types scripts/notification-dispatch.test.mjs",
    "smoke": "node --env-file-if-exists=.env.local scripts/smoke.mjs",
    "test:messages": "node --experimental-strip-types scripts/messages.mjs",
    "check": "pnpm typecheck && pnpm test:messages && pnpm test:compat && pnpm test:match && pnpm test:earnings && pnpm test:share && pnpm test:saved && pnpm test:nextaction && pnpm test:reads && pnpm test:security-libs && pnpm test:seo && node --experimental-strip-types scripts/notification-links.test.mjs && node --experimental-strip-types scripts/notification-dispatch.test.mjs && pnpm test:db && pnpm test:concurrency",
    "test:search": "node --experimental-strip-types supabase/tests/search.test.mjs",
    "bench:search": "node --experimental-strip-types supabase/tests/search-bench.mjs",
    "test:email": "node --experimental-strip-types supabase/tests/email.test.mjs",
    "auth:templates": "node --experimental-strip-types scripts/auth-templates.mjs",
    "test:auth": "node --experimental-strip-types supabase/tests/auth.test.mjs",
    "test:jobs": "node --experimental-strip-types supabase/tests/jobs.test.mjs && node --experimental-strip-types scripts/jobs.test.mjs",
    "test:concurrency": "node supabase/tests/concurrency.test.mjs",
    "test:support": "node supabase/tests/support.test.mjs",
    "test:compat": "node scripts/compat.mjs",
    "test:match": "node --experimental-strip-types scripts/match.test.mjs",
    "test:earnings": "node --experimental-strip-types scripts/earnings.test.mjs",
    "test:share": "node --experimental-strip-types scripts/share-source.test.mjs",
    "test:saved": "node --experimental-strip-types scripts/saved-search.test.mjs",
    "test:nextaction": "node --experimental-strip-types scripts/next-action.test.mjs",
    "test:reads": "node scripts/reads.test.mjs",
    "test:security": "node supabase/tests/security.test.mjs",
    "test:security-libs": "node --experimental-strip-types scripts/security-libs.test.mjs",
    "crawl": "node scripts/crawl.mjs",
    "perf:budget": "node scripts/perf-budget.mjs",
    "test:seo": "node --experimental-strip-types scripts/job-posting.test.mjs && node --experimental-strip-types scripts/record-exists.test.mjs",
    "seo:check": "node --experimental-strip-types scripts/seo-check.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.2",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.49.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "marked": "^18.0.11",
    "next": "15.5.24",
    "next-intl": "^4.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "pg": "^8.23.0",
    "tailwindcss": "^4.0.9",
    "tw-animate-css": "^1.2.4",
    "typescript": "^5.7.3"
  }
}
